{
  "name": "aws-cdk-deployment-1a",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app (TypeScript)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "clean": "rimraf dist cdk.out",
    "synth": "npm run build && cdk synth",
    "deploy": "npm run build && cdk deploy --all",
    "destroy": "cdk destroy --all",
    "lint": "eslint --ext .ts .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "jest",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "aws-cdk-lib": "^2",
    "constructs": "^10"
  },
  "devDependencies": {
    "aws-cdk": "^2",
    "typescript": "^5",
    "ts-node": "^10",
    "@types/node": "^18",
    "eslint": "^8",
    "eslint-config-prettier": "^8",
    "prettier": "^2",
    "husky": "^8",
    "lint-staged": "^14",
    "rimraf": "^5",
    "jest": "^29",
    "ts-jest": "^29"
  }
}

